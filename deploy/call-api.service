[Unit]
Description=FreePBX call origination API (FastAPI)
After=network.target asterisk.service
Wants=asterisk.service

[Service]
Type=simple
User=asterisk
WorkingDirectory=/opt/call-api
EnvironmentFile=/etc/call-api/environment
# Variáveis obrigatórias em /etc/call-api/environment:
#   DB_PATH, AMI_USER, AMI_SECRET, ADMIN_USER, ADMIN_PASSWORD, ADMIN_SECRET_KEY
#   SOUNDS_BASE_DIR, RECORDINGS_BASE_PATH, ACCESS_LOG_PATH
# Consulte env.example para a lista completa.
ExecStart=/opt/call-api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
