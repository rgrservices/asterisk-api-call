# ──────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores antes de iniciar a API.
# ──────────────────────────────────────────────────────────────────────────────

# ── Banco de dados ────────────────────────────────────────────────────────────
DB_PATH=call_api.db
# Produção:
# DB_PATH=/opt/call-api/call_api.db

# ── Log de acesso ─────────────────────────────────────────────────────────────
ACCESS_LOG_PATH=logs/access.log
# Produção:
# ACCESS_LOG_PATH=/var/log/call-api/access.log

# ── AMI — Asterisk Manager Interface ─────────────────────────────────────────
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=call-api
AMI_SECRET=senha-secreta-ami
AMI_ORIGINATE_TIMEOUT_MS=30000
AMI_CONTEXT=call-api-playback

# ── Áudio — gravações ─────────────────────────────────────────────────────────
# Diretório base de sons do Asterisk (absoluto no servidor)
SOUNDS_BASE_DIR=/var/lib/asterisk/sounds
# Subdiretório dentro de SOUNDS_BASE_DIR onde ficam as gravações por cliente
# Estrutura: {SOUNDS_BASE_DIR}/{RECORDINGS_BASE_PATH}/{client_id}/{arquivo}.wav
RECORDINGS_BASE_PATH=custom

# ── Admin UI ──────────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Chave secreta para assinatura do cookie de sessão (use openssl rand -hex 32)
ADMIN_SECRET_KEY=gere-com-openssl-rand-hex-32

# ── Legado — usados somente pelo script de migração ──────────────────────────
# CALL_API_TOKENS_FILE=examples/tokens.example.yaml
# CALL_API_COMPANIES_FILE=examples/companies.example.yaml
